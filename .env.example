# Server only. Copy this file to .env.local and insert your private key there.
OPENAI_API_KEY=
# Optional: require all instances to use the same signing secret.
# If omitted, the server derives a signing key from OPENAI_API_KEY.
GAME_SIGNING_SECRET=
# Optional persistent rate limits (free Upstash Redis tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
